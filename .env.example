# Toggle entre modelos reales y falsos. Con true, nada necesita vLLM ni Ollama.
FAKE_MODELS=true

# PDF del artículo (montado read-only dentro de los contenedores en /resources/)
PAPER_PATH=resources/article.pdf

# ---------- Modelos (vLLM, OpenAI-compatible API) ----------
# Embeddings: nvidia/Nemotron-3-Embed-1B-BF16 (2048 dims nativos; recortamos a EMBED_DIM y renormalizamos)
EMBED_URL=http://vllm-embed:8000/v1
EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
EMBED_DIM=1024

# Reranker: nvidia/llama-nemotron-rerank-1b-v2 (requiere --trust-remote-code en vLLM)
RERANK_URL=http://vllm-rerank:8000/v1
RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
USE_RERANKER=true

# VLM para describir figuras en la ingesta: Qwen/Qwen2.5-VL-7B-Instruct
VLM_URL=http://vllm-vlm:8000/v1
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# ---------- LLM generador (Ollama nativo en la Mac del host) ----------
# Los contenedores llaman al host por host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=nemotron-3-nano:4b

# ---------- Infra ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
REDIS_URL=redis://redis:6379/0
OPENSEARCH_URL=http://opensearch:9200

# ---------- Admin y túnel ----------
ADMIN_TOKEN=changeme-admin-token
NGROK_AUTHTOKEN=
